{
  "name": "avi-salesconnect",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "test": "node --test tests/unit/*.test.js tests/db/*.test.js",
    "check": "node --check packages/domain/index.js && npm test && npm run build",
    "dev": "vite apps/web",
    "build": "tsc -p apps/web/tsconfig.json && vite build apps/web",
    "test:hosted": "node --env-file=.env --test tests/integration/hosted-access.test.js",
    "test:local-auth": "node --test tests/integration/local-auth.test.js",
    "dev:bootstrap": "node scripts/bootstrap-local.mjs",
    "test:e2e": "playwright test",
    "test:clamav": "node --test tests/integration/clamav.test.js"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.6.0",
    "@playwright/test": "1.65.1",
    "@types/react": "19.3.2",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "supabase": "3.4.0",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@supabase/supabase-js": "2.119.2",
    "heic-to": "1.6.7",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
